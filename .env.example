# --- Database ---
# Matches docker-compose.yml for local dev. Point at your Supabase connection
# string instead for staging/production.
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (queue + agent state) ---
REDIS_URL=redis://localhost:6379

# --- Meta WhatsApp Business Graph API ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_PHONE_NUMBER_ID=

# --- AI Providers ---
# Gemini is the active provider (packages/agents/src/gemini-domain-agent.ts) —
# free tier on Flash-family models. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Kept for reference / rollback to packages/agents/src/domain-agent.ts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Zipicka storefront (check_inventory tool) ---
# Shopify STOREFRONT API access for live stock lookups (public, read-only
# token — X-Shopify-Storefront-Access-Token). Leave blank to disable — the
# agent then escalates stock questions to a human instead of guessing.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- API ---
API_PORT=8080
NODE_ENV=development

# --- Command deck (login) ---
# Operator credential for the /login → /deck console. Change both for prod.
NEXUS_OPERATOR_PASSWORD=demo1234
NEXUS_SESSION_SECRET=change-me-to-a-long-random-string
# Parent domain so the operator session cookie also reaches api.<domain>.
# The API verifies this same session — without it, browser calls get 401.
# Leave blank for local development (everything is on localhost).
SESSION_COOKIE_DOMAIN=.yourdomain.com
# Optional bearer token for non-browser callers (scripts, integrations).
# Leave blank to accept session cookies only.
NEXUS_API_TOKEN=

# --- Web (Unified Inbox) ---
# Ignored by docker-compose.prod.yml — that stack derives these from
# API_DOMAIN below and bakes them into the web image at build time instead
# (see Dockerfile.web). Only used for plain `npm run dev:web`.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# --- Production only (docker-compose.prod.yml) ---
# Ignored by `npm run dev:*` / docker-compose.yml (local dev). See DEPLOY.md.
POSTGRES_PASSWORD=
# Least-privilege role the APPLICATION connects as (migration 006). Migrations
# still run as the owner. Set APP_DB_USER=nexus_app and generate the password on
# the server so it never passes through a client:
#   PW=$(openssl rand -hex 24)
#   psql -c "create role nexus_app login password '$PW'"
#   echo "APP_DB_PASSWORD=$PW" >> .env
# Running the app as the superuser owner makes row-level security unenforceable
# (superusers bypass RLS unconditionally) and turns any SQL injection into full
# database control.
APP_DB_USER=nexus_app
APP_DB_PASSWORD=
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=app.yourdomain.com
# Bare domain the app is ALSO served on (Caddyfile serves both). Included in
# the API's CORS allowlist — without it, the bare domain loads but every API
# call fails and the UI shows an empty state rather than an error.
ROOT_DOMAIN=yourdomain.com
