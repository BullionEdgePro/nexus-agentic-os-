# --- Database ---
# Matches docker-compose.yml for local dev. Point at your Supabase connection
# string instead for staging/production.
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (queue + agent state) ---
REDIS_URL=redis://localhost:6379

# --- Meta WhatsApp Business Graph API ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_PHONE_NUMBER_ID=

# --- AI Providers ---
# CORRECTED 2026-08-17. This block said Gemini was the active provider and that
# Anthropic was "kept for reference / rollback". It is the other way round, and
# had been for some time — production's own boot log settles it:
#   "Model preflight OK" claude-sonnet-5      tenants: all five businesses
#   "Model preflight OK" gemini-embedding-001 tenants: <embeddings>
# Following the old wording you would provision Gemini, skip Anthropic, and get
# a platform where every single reply is the "I'm looping in a specialist"
# fallback while every container reports healthy — which is not a hypothetical
# failure here, it is one this system has already had twice.

# REQUIRED. Every text-generating call: the domain agents, the switchboard, the
# hallucination judge, procedure inference. Without it the agent answers nothing
# and the fallback goes out instead. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# REQUIRED. Embeddings only — Anthropic does not offer an embedding model, so
# knowledge ingestion and retrieval run on Gemini. Without it, indexing fails
# and the agent answers ungrounded, telling customers a colleague will confirm.
# Free tier is sufficient. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Zipicka storefront (check_inventory tool) ---
# Shopify STOREFRONT API access for live stock lookups (public, read-only
# token — X-Shopify-Storefront-Access-Token). Leave blank to disable — the
# agent then escalates stock questions to a human instead of guessing.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# --- API ---
API_PORT=8080
NODE_ENV=development

# --- Command deck (login) ---
# Operator credential for the /login → /deck console. Change both for prod.
NEXUS_OPERATOR_PASSWORD=demo1234
NEXUS_SESSION_SECRET=change-me-to-a-long-random-string
# Parent domain so the operator session cookie also reaches api.<domain>.
# The API verifies this same session — without it, browser calls get 401.
# Leave blank for local development (everything is on localhost).
SESSION_COOKIE_DOMAIN=.yourdomain.com
# Optional bearer token for non-browser callers (scripts, integrations).
# Leave blank to accept session cookies only.
NEXUS_API_TOKEN=

# --- Web (Unified Inbox) ---
# Ignored by docker-compose.prod.yml — that stack derives these from
# API_DOMAIN below and bakes them into the web image at build time instead
# (see Dockerfile.web). Only used for plain `npm run dev:web`.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# --- Production only (docker-compose.prod.yml) ---
# Ignored by `npm run dev:*` / docker-compose.yml (local dev). See DEPLOY.md.
POSTGRES_PASSWORD=
# Least-privilege role the APPLICATION connects as (migration 006). Migrations
# still run as the owner. Set APP_DB_USER=nexus_app and generate the password on
# the server so it never passes through a client:
#   PW=$(openssl rand -hex 24)
#   psql -c "create role nexus_app login password '$PW'"
#   echo "APP_DB_PASSWORD=$PW" >> .env
# Running the app as the superuser owner makes row-level security unenforceable
# (superusers bypass RLS unconditionally) and turns any SQL injection into full
# database control.
APP_DB_USER=nexus_app
APP_DB_PASSWORD=
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=app.yourdomain.com
# Bare domain the app is ALSO served on (Caddyfile serves both). Included in
# the API's CORS allowlist — without it, the bare domain loads but every API
# call fails and the UI shows an empty state rather than an error.
ROOT_DOMAIN=yourdomain.com

# --- Read by the code, and previously documented nowhere ---
# Added 2026-08-17 after comparing every `process.env.X` in the source against
# this file. Six were missing. Each one below has a default, which is exactly
# why their absence here was dangerous: a fresh deploy inherits the default
# silently and nothing reports that it did.

# HOW LOUDLY A MISSING TENANT CONTEXT FAILS. This is the most important line in
# this file after the database credentials.
#   strict — throw. What production runs, and what RLS requires: once policies
#            are enabled a query with no tenant context returns ZERO ROWS AND NO
#            ERROR, which every caller reads as "this business has no data".
#   warn   — log and continue. The DEFAULT, correct only while paths are being
#            migrated.
#   off    — nothing.
# Omitting this does not disable tenant isolation, it disables the alarm on it:
# the platform keeps running and the one mechanism that catches a forgotten
# scope goes quiet. Set it to strict on any deployment with RLS applied.
DB_TENANT_ASSERT=strict

# Owner credentials for `npm run db:migrate`. The application connects as the
# least-privilege role above, which deliberately has no CREATE — so migrations
# run as the owner or not at all. Unset, the migration runner falls back to
# DATABASE_URL: right for local development where they are the same role, wrong
# in production, where it fails a third of the way in with `permission denied
# for schema public` and a stack trace that names no cause.
# MIGRATION_DATABASE_URL=postgresql://nexus:PASSWORD@postgres:5432/nexus

# Model overrides. Defaults are compiled in and are the models this platform is
# actually tested on; set these only when a provider retires one under you.
# That is not hypothetical here: `gemini-2.5-flash` began returning 404 for
# newly-created keys while `models.list` still advertised it, and because the
# reply path catches model errors and sends a polite fallback, the symptom was
# every customer receiving "I'm looping in a specialist" from a system whose
# containers were all green. `preflightModels()` now names the broken model at
# worker boot; these are how you fix it without a code change.
# NEXUS_AGENT_MODEL=claude-sonnet-5
# NEXUS_ROUTER_MODEL=claude-haiku-4-5
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# CORS allowlist for the API, comma-separated. docker-compose.prod.yml builds
# this from WEB_DOMAIN and ROOT_DOMAIN, so leave it unset there; it exists for
# running the API outside compose.
# WEB_ORIGIN=https://app.yourdomain.com,https://yourdomain.com

# ------------------------------------------------------------
# Operator alerts — off unless you set a destination
# ------------------------------------------------------------
#
# Sixteen operators sweep the database every ten minutes and record what is
# wrong. Without this, nothing tells anybody: the findings sit on the deck and
# the deck has to be opened. A knowledge outage once stood sixteen hours that
# way, and a customer waited seventeen.
#
# Any URL that accepts a JSON POST — a Slack or Discord incoming webhook, a
# relay, an endpoint of your own. Must be https.
#
# WHAT GETS SENT: which business, which operator, how severe, and a link to the
# deck. WHAT DOES NOT: the finding's title, its detail, the customer's name, or
# any message body. A title reads "Ahmed has been waiting 3 hours" — useful on
# your own screen, not something to post to a third-party URL. The alert is a
# doorbell; the letter stays behind your sign-in.
#
# It fires only when a problem STARTS, never on every sweep, so a standing
# problem does not repeat itself every ten minutes until you mute the channel.
# OPERATOR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Whether a warning is worth a notification too. Off by default: "a customer has
# waited two hours" belongs on a page, not on a phone at 3am.
# ALERT_ON_WARN=true

# Backups: the nightly dump is kept in /opt/nexus/backups. Set BACKUP_REMOTE and
# BACKUP_PASSPHRASE in /etc/nexus-backup.env to also send an encrypted copy off
# the machine.
#
# If you have deliberately decided NOT to, set this to 1. It silences the deck
# finding about it and nothing else -- backup-check still reports "NOT off-box"
# on every run, because the decision changes what is worth nagging about, not
# what is true.
BACKUP_OFFSITE_WAIVED=0
