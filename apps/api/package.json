{
  "name": "@nexus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "start:worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --test test/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@nexus/agents": "*",
    "@nexus/db": "*",
    "@nexus/employees": "*",
    "@nexus/governance": "*",
    "@nexus/knowledge": "*",
    "@nexus/leads": "*",
    "@nexus/shared": "*",
    "bullmq": "^5.28.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.9",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.6.0"
  }
}
